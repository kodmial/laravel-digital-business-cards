{
    "name": "digital-card-kit/laravel-digital-business-cards",
    "description": "Reusable digital business cards for Laravel applications.",
    "keywords": [
        "business card",
        "digital business card",
        "filament",
        "laravel",
        "vcard"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/kodmial/laravel-digital-business-cards",
    "support": {
        "issues": "https://github.com/kodmial/laravel-digital-business-cards/issues",
        "source": "https://github.com/kodmial/laravel-digital-business-cards"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.6",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/notifications": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "league/csv": "^9.28",
        "league/uri": "^7.8",
        "propaganistas/laravel-phone": "^6.0",
        "sabre/vobject": "^4.5|^5.0",
        "spatie/color": "^2.1",
        "spatie/laravel-package-tools": "^1.93"
    },
    "autoload": {
        "psr-4": {
            "DigitalCardKit\\Laravel\\": "src/",
            "DigitalCardKit\\Laravel\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DigitalCardKit\\Laravel\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=256M",
        "format": "pint",
        "lint": "pint --test",
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "DigitalCardKit\\Laravel\\DigitalBusinessCardsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
